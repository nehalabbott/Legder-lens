# Copy this file to `.env` in the project root and fill in real values.
# `.env` is already excluded via .gitignore -- never commit real secrets.

# Required for Tier 2 AI diagnostics, the Streamlit Q&A assistant, and the
# webhook gateway's live diagnosis call. Without it, every component falls
# back to deterministic, clearly-labeled placeholder behavior.
GROQ_API_KEY=your_groq_api_key_here

# Required to verify that incoming webhook calls really came from Razorpay.
# If unset, the webhook gateway logs a loud warning and (in non-strict mode)
# accepts unsigned requests -- see README "Security Notes" before using this
# in anything resembling production.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: set to "true" to make the webhook gateway refuse all requests
# when RAZORPAY_WEBHOOK_SECRET is not configured, instead of warning and
# accepting them unsigned.
WEBHOOK_STRICT_MODE=false

# Optional: Slack/Teams incoming webhook URL for src/alerts.py. If unset,
# the alert is printed to stdout only (default demo behavior).
FINANCE_ALERT_WEBHOOK_URL=
